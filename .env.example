# Stellar Frontier · API (apps/api) — окружение M11/M12
# Скопируйте в .env и экспортируйте (или используйте docker compose для PG/Redis).

# HTTP/WSS
HOST=127.0.0.1
PORT=8787

# Персистентность:
#   auto (по умолчанию) — PostgreSQL при DATABASE_URL, иначе durable file-store в .data/
#   file — всегда file-store, postgres — только PostgreSQL, none — без хранения (unit/e2e)
SF_PERSISTENCE=auto
SF_DATA_DIR=.data
DATABASE_URL=postgres://sf:sf@127.0.0.1:5432/stellar_frontier
# Redis опционален: presence/кэш комнат/сезонные ключи; без него сервер работает
REDIS_URL=redis://127.0.0.1:6379

# Интервал дебаунса записи снапшота (мс) и TTL сезона
SF_PERSIST_INTERVAL_MS=1500
SF_SEASON_TTL_MS=2592000000

# Тестовые оверрайды скорости (coop)
SF_COOP_TICK_MS=1000
SF_COOP_SNAPSHOT_MS=1000

# Админ-токен: включает /admin/flush, /admin/stats, /season/reset (заголовок x-admin-token)
SF_ADMIN_TOKEN=change-me

# --- Hardening M11/1.0 ---
# Секрет HMAC токенов реконнекта (>=8 символов); если не задан — стабильный .data/token-secret
SF_TOKEN_SECRET=change-me-token-secret
SF_TOKEN_TTL_MS=86400000
# CORS allowlist через запятую (пусто = dev '*')
SF_CORS_ORIGINS=
SF_HTTP_RATE_PER_MIN=240
SF_WS_MAX_CONNECTIONS=1200
